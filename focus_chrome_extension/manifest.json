{
  "manifest_version": 3,
  "name": "Focus Extension",
  "version": "1.0",
  "description": "Why you wasting time looking at my description?",
  "permissions": ["storage", "tabs", "webNavigation", "nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}],
}